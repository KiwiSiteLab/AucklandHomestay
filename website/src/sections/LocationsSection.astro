---
import LocationMap from '../components/LocationMap.astro';import {locations} from '../data/locations';
---
<section class="section container locations-section"><div class="location-intro"><h2 class="display">Close to the city.<br><em>Closer to everyday.</em></h2><p>从住宿位置，找到适合你的城市生活。</p><a class="text-link" href="/locations/">了解住宿位置</a></div>{locations.length>1&&<div class="location-tabs" aria-label="选择住宿区域">{locations.map((group,i)=><button data-location-to={group.id} aria-pressed={i===0}>{group.name}</button>)}</div>}{locations.map((group,i)=><div class="location-layout" data-location-panel={group.id} hidden={i!==0}><div class="location-index"><span>{group.name}</span><h3>{group.address.split(',')[0]}</h3><p>{group.name}, New Zealand</p><div class="location-property-list">{group.properties.map(p=><a href={`/stays/${p.slug}/`}>{p.name}</a>)}</div><small>{group.properties.length} 套独立住宿 · 查看实际位置</small></div><LocationMap property={group.properties[0]}/></div>)}</section>
