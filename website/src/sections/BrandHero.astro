---
import ResponsiveImage from '../components/ResponsiveImage.astro';import {brandSlides} from '../data/landscapes';
---
<section class="brand-hero background-gallery" aria-labelledby="hero-heading" data-hero><div class="hero-slides">{brandSlides.map((photo,i)=><div class:list={['hero-slide',{'is-active':i===0,'is-portrait':photo.portrait}]} data-slide data-scene={photo.id} data-caption={photo.caption} data-portrait={String(photo.portrait)} aria-hidden={i!==0} style={`--scene-position:${photo.position};--scene-mobile-position:${photo.mobilePosition}`}>
{photo.portrait&&<div class="hero-ambient" aria-hidden="true"><ResponsiveImage photo={{...photo,alt:''}} deferred={i!==0} sizes="80vh"/></div>}
<div class="hero-sharp"><ResponsiveImage photo={photo} priority={i===0} deferred={i!==0} sizes={photo.portrait?'(min-aspect-ratio: 1.05) 80vh, 100vw':`max(100vw, ${Math.ceil(photo.width/photo.height*100)}vh)`}/></div></div>)}</div><canvas class="hero-canvas" aria-hidden="true"></canvas><div class="hero-local-shade"></div><div class="container hero-copy"><span class="hero-location">Victoria House · Auckland, New Zealand</span><h1 id="hero-heading"><span>Auckland,</span><em>at your pace.</em></h1><p>栖居城市，心向山海。</p><div class="hero-actions"><a class="button button-light" href="/stays/">探索独立住宿 <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/booking/">安排我的入住</a></div></div><div class="hero-bottom"><div class="hero-scene-info"><span data-scene-count>01 / 07</span><span data-scene-caption>{brandSlides[0].caption}</span></div></div></section>
