---
import ResponsiveImage from '../components/ResponsiveImage.astro';import {landscapes} from '../data/landscapes';
---
<section class="booking-cta" data-landscape><div class="landscape-media"><ResponsiveImage photo={landscapes.companions} sizes="max(100vw, 110vh)"/></div><div class="booking-cta-shade"></div><div class="container booking-cta-copy"><span class="landscape-location">New Zealand · Shared moments</span><h2 class="display" data-reveal>Your next chapter<br>begins <em>here.</em></h2><p>从奥克兰的居所，开启你的新西兰旅程。</p><div><a class="button button-light" href="/stays/">探索房源 <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/contact/">联系我们</a></div></div><span class="landscape-caption">新西兰旅途灵感</span></section>
