---
import LandscapeBreak from '../components/LandscapeBreak.astro';import BaseLayout from '../layouts/BaseLayout.astro';import Gallery from '../components/Gallery.astro';import {properties,editorialPhotos} from '../data/properties';
---
<BaseLayout title="真实影像与住宿相册" image={editorialPhotos[0].src}><section class="page-heading container"><p class="section-label">The visual journal</p><h1 class="display">Light. Space.<br><em>Everyday.</em></h1><p>走近空间，也走近一段可能属于你的日常。</p></section><section class="container gallery-page section"><div class="gallery-filters" aria-label="按房源查看影像"><button data-gallery-filter="all" aria-pressed="true">全部影像</button>{properties.map(p=><button data-gallery-filter={p.id} aria-pressed="false">{p.chineseName}</button>)}</div>{properties.map(p=><div class="gallery-collection" data-collection-property={p.id}><div class="gallery-collection-heading"><h2>{p.name}</h2><a class="text-link" href={`/stays/${p.slug}/`}>了解这套住宿</a></div><Gallery photos={p.gallery} title={p.name}/></div>)}</section><LandscapeBreak scene="forest" title="The art of slowing down." subtitle="在房间之外，还有值得慢慢感受的风景。" compact/></BaseLayout>
