---
import BaseLayout from '../layouts/BaseLayout.astro';import BrandHero from '../sections/BrandHero.astro';import FeaturedStays from '../sections/FeaturedStays.astro';import ExperienceSection from '../sections/ExperienceSection.astro';import ImageBreak from '../sections/ImageBreak.astro';import LocationsSection from '../sections/LocationsSection.astro';import BookingCTA from '../sections/BookingCTA.astro';import Gallery from '../components/Gallery.astro';import {editorialPhotos} from '../data/properties';import {brandSlides} from '../data/landscapes';
---
<BaseLayout title="奥克兰精品旅居" overlay image={brandSlides[0].src}><link slot="head" rel="preload" as="image" href={brandSlides[0].src} imagesrcset={brandSlides[0].avifSrcset||brandSlides[0].srcset} type={brandSlides[0].avifSrcset?"image/avif":"image/webp"} imagesizes={`max(100vw, ${Math.ceil(brandSlides[0].width/brandSlides[0].height*100)}vh)`} fetchpriority="high"/><BrandHero/><section id="collection" class="brand-introduction section container"><span class="section-label">Victoria House</span><h2 class="display">Considered spaces.<br><em>Auckland living.</em></h2><p>从一间明亮的居所，开始一段新的城市生活。<br>Victoria House 汇集独立住宿，让生活所需与自己的节奏安放在一起。</p><a class="text-link" href="/about/">认识 Victoria House</a></section><FeaturedStays/><ExperienceSection/><ImageBreak/><LocationsSection/><section class="section container home-gallery"><div class="gallery-intro"><h2 class="display">Life, in <em>detail.</em></h2><p>空间、光线与窗外的城市。<br>从真实影像里，感受你的下一段日常。</p></div><Gallery photos={editorialPhotos.slice(0,4)}/><div class="section-end"><a href="/gallery/" class="text-link">探索完整影像集</a></div></section><section class="section values-section"><div class="container values-layout"><div><h2 class="display">Thoughtful stays.<br><em>Simple comforts.</em></h2><p>我们关注空间本身，也关注你在这里度过的日常。</p></div><div class="values-list"><div><h3>空间，各有性格。</h3><p>独立住宿，真实影像，为你的居住偏好提供选择。</p></div><div><h3>生活所需，已备好。</h3><p>家具家电、水电网络包含，让新的日常更容易开始。</p></div><div><h3>位置，让日常轻松。</h3><p>靠近城市生活，兼顾出行与采购的便利。</p></div></div></div></section><BookingCTA/></BaseLayout>
