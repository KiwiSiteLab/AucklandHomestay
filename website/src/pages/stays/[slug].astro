---
import LandscapeBreak from '../../components/LandscapeBreak.astro';import BaseLayout from '../../layouts/BaseLayout.astro';import ResponsiveImage from '../../components/ResponsiveImage.astro';import Gallery from '../../components/Gallery.astro';import LocationMap from '../../components/LocationMap.astro';import BookingLink from '../../components/BookingLink.astro';import PropertyPreview from '../../components/PropertyPreview.astro';import {properties,propertyUrl,type Property} from '../../data/properties';
export function getStaticPaths(){return properties.map(property=>({params:{slug:property.slug},props:{property}}));}
const {property:p}=Astro.props as {property:Property};
const origin=Astro.site||new URL('http://127.0.0.1:4173');
const schema={'@context':'https://schema.org','@type':'LodgingBusiness','name':`${p.name} · Victoria House`,'description':p.shortDescription,'url':new URL(propertyUrl(p),origin).href,'image':p.gallery.map(img=>new URL(img.src,origin).href),'address':{'@type':'PostalAddress','streetAddress':p.address.split(',')[0],'addressLocality':'Auckland','addressCountry':'NZ'},'amenityFeature':p.amenities.map(name=>({'@type':'LocationFeatureSpecification',name,value:true}))};
const facts=[{label:'住客',value:p.guests},{label:'卧室',value:p.bedrooms},{label:'卫浴',value:p.bathrooms}].filter(f=>f.value!==null);
---
<BaseLayout title={`${p.name} ${p.chineseName}`} description={p.shortDescription} image={p.heroImage.src} schema={schema}><section class="container property-heading"><nav class="breadcrumbs" aria-label="面包屑"><a href="/stays/">全部住宿</a><span>/</span><span>{p.chineseName}</span></nav><p class="property-area">{p.location}</p><h1 class="display">{p.name}</h1><div class="property-heading-bottom"><p>{p.chineseName}<span> · </span>{p.mood}</p><a class="text-link" href="#book-property">咨询入住</a></div></section><section class="property-hero-image"><ResponsiveImage photo={p.heroImage} priority sizes="100vw"/></section><section class="container property-overview section"><div class="property-description"><h2>属于自己的，<br>一段城市日常。</h2>{p.description.map(paragraph=><p>{paragraph}</p>)}</div><aside class="property-summary"><span class="section-label">At a glance</span>{facts.length>0?<dl>{facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>:<div class="known-facts"><p>独立住宿</p><p>家具家电齐备</p><p>水电网络包含</p></div>}<address>{p.address}</address>{p.priceFrom!==null&&<p class="price-from">NZ$ {p.priceFrom} 起</p>}<small>人数、租期与费用，请联系确认。</small></aside></section><section class="container section property-gallery-section"><div class="gallery-intro"><h2 class="display">Inside <em>the stay.</em></h2><p>房源实拍，保留空间本来的样子。</p></div><Gallery photos={p.gallery} title={p.name}/></section><section class="amenities-section"><div class="container amenities-layout"><h2>为生活，<br>备好这些。</h2><ul>{p.amenities.map(item=><li>{item}</li>)}</ul></div></section><section class="container section detail-location"><div><h2 class="display">Here in <em>Auckland.</em></h2><h3>{p.location}</h3><address>{p.address}</address><p>靠近天空塔、高速与各大超市。</p><a href={p.map.searchUrl} target="_blank" rel="noopener noreferrer" class="text-link">打开地图导航</a></div><LocationMap property={p}/></section><LandscapeBreak scene="mountain" title="Room for a different rhythm." subtitle="留一点时间，去遇见新西兰。" compact/><section class="property-booking section" id="book-property"><div class="container property-booking-inner"><div><h2 class="display">Make it <em>your stay.</em></h2><p>告诉我们你的入住计划，<br>了解 {p.chineseName} 的房源与安排。</p></div><BookingLink property={p}/></div></section><section class="container section related-stays"><h2 class="display">Also in <em>the collection.</em></h2><div class="related-grid">{properties.filter(other=>other.id!==p.id).slice(0,2).map(other=><PropertyPreview property={other}/>)}</div></section></BaseLayout>
