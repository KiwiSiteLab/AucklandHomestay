---
import LandscapeBreak from '../components/LandscapeBreak.astro';import BaseLayout from '../layouts/BaseLayout.astro';import EnquiryForm from '../components/EnquiryForm.astro';import {brand} from '../data/brand';
---
<BaseLayout title="联系与入住咨询" description="联系 Victoria House，咨询奥克兰独立住宿、入住日期、租期与费用。使用房东微信二维码了解三套房源。"><section class="page-heading container"><p class="section-label">Let’s make you at home</p><h1 class="display">Every stay starts<br>with a <em>conversation.</em></h1><p>告诉我们你的计划，一起找到适合的住宿。</p></section><section class="container contact-layout section"><EnquiryForm/><aside class="contact-aside"><h2>直接聊聊</h2><p>扫描二维码添加微信。<br>在手机上，可保存后在微信识别。</p><button class="contact-qr" data-wechat aria-label="放大微信联系二维码"><img src={brand.wechat} width="888" height="1131" alt="房东微信联系二维码"/></button><a class="text-link" href={brand.wechat} download="Victoria-House-WeChat.jpg">保存二维码</a><div class="contact-aside-details"><h3>住宿位置</h3><address>{brand.address}</address>{brand.email?<a href={`mailto:${brand.email}`}>{brand.email}</a>:<p class="small-note">邮箱与电话待更新，目前请使用微信联系。</p>}{brand.phone&&<a href={`tel:${brand.phone}`}>{brand.phone}</a>}{brand.instagram&&<a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}</div></aside></section><LandscapeBreak scene="lake" title="A journey, thoughtfully begun." subtitle="从一次交谈，开始一段新的旅居。" compact/></BaseLayout>
