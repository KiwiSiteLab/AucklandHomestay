---
import LandscapeBreak from '../components/LandscapeBreak.astro';import BaseLayout from '../layouts/BaseLayout.astro';import ResponsiveImage from '../components/ResponsiveImage.astro';import BookingLink from '../components/BookingLink.astro';import {properties,propertyUrl} from '../data/properties';
---
<BaseLayout title="预订住宿与安全付款" description="选择 Victoria House 的独立住宿，联系确认日期、费用与租期，再进入对应预订或安全付款链接。"><section class="page-heading container"><p class="section-label">Your next chapter</p><h1 class="display">Make Auckland<br><em>your own.</em></h1><p>选择心仪住宿，先确认房源与入住安排，<br>再通过专属链接完成预订或付款。</p></section><section class="container booking-page-list">{properties.map(p=><article class="booking-property" data-booking-property={p.id}><a class="booking-property-photo" href={propertyUrl(p)}><ResponsiveImage photo={p.heroImage}/></a><div><span class="property-area">{p.location}</span><h2><a href={propertyUrl(p)}>{p.name}</a></h2><p>{p.chineseName}</p><p class="booking-property-description">{p.shortDescription}</p></div><BookingLink property={p}/></article>)}</section><section class="container booking-note"><h2>把入住安排，先说清楚。</h2><p>预订前请确认日期、人数、租期、金额、币种与取消约定。付款页面由收款平台提供，本站不收集银行卡信息。</p><a class="text-link" href="/terms/">阅读入住与付款须知</a></section><LandscapeBreak scene="sunset" title="Leave room for wonder." subtitle="安顿好日常，再去遇见山海。" compact/></BaseLayout>
