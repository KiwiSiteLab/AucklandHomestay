---
import {brand} from '../data/brand';
---
<dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-title"><button class="close-button" data-close aria-label="关闭微信二维码">×</button><div class="wechat-inner"><span class="meta">Victoria House</span><h2 id="wechat-title">聊聊你的入住计划</h2><p>扫码添加微信，或保存二维码后在微信识别。</p><img src={brand.wechat} width="888" height="1131" alt="用户提供的房东微信联系二维码" loading="lazy"/><a class="button" href={brand.wechat} download="Victoria-House-WeChat.jpg">保存二维码</a></div></dialog>
