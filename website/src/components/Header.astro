---
import Logo from './Logo.astro';import {brand} from '../data/brand';import {properties} from '../data/properties';
const {overlay=false}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/$/,'');const current=base&&Astro.url.pathname.startsWith(base)?Astro.url.pathname.slice(base.length)||'/':Astro.url.pathname;
---
<header id="site-header" class:list={['site-header',{'header-overlay':overlay}]}>
  <Logo/><nav class="desktop-nav" aria-label="主导航">{brand.nav.map((item,i)=><div class="nav-item" data-nav-item={i<2?String(i):undefined}><a href={item.href} aria-current={current.startsWith(item.href)?'page':undefined}>{item.label}</a>{i<2&&<button class="nav-trigger" data-nav-trigger={i} aria-label={`展开${item.label}`} aria-expanded="false" aria-controls={`nav-panel-${i}`}><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>}</div>)}</nav>
  <a class="header-book button button-small" href="/booking/">预订住宿</a>
  <div class="nav-popover" data-nav-popover><div class="nav-panel" id="nav-panel-0" data-nav-panel="0" inert><div class="nav-panel-heading"><span>THE COLLECTION</span><p>三套住宿，各有自己的生活节奏。</p></div><div class="nav-properties">{properties.map(p=><a class="nav-property" href={`/stays/${p.slug}/`}><img src={p.heroImage.src} srcset={p.heroImage.srcset} sizes="220px" alt="" width="220" height="112" loading="lazy"/><span><strong>{p.chineseName}</strong><small>{p.name}</small></span><span class="nav-row-arrow" aria-hidden="true">→</span></a>)}</div><a class="nav-panel-footer text-link" href="/stays/">探索全部独立住宿</a></div><div class="nav-panel" id="nav-panel-1" data-nav-panel="1" inert><div class="nav-panel-heading"><span>AUCKLAND & BEYOND</span><p>从城市的居所，走向山海。</p></div><div class="nav-experiences"><a href="/experience/"><strong>旅居体验</strong><small>空间、日常与新西兰旅途</small></a><a href="/gallery/"><strong>真实影像</strong><small>看看房间的每一个细节</small></a><a href="/locations/"><strong>城市位置</strong><small>147 Victoria Street West</small></a></div><a class="nav-panel-footer text-link" href="/experience/">发现你的旅居节奏</a></div></div>
  <button class="menu-toggle" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="主导航"><div class="menu-top"><Logo/><button class="close-button" data-close aria-label="关闭导航">×</button></div><nav aria-label="手机主导航">{brand.nav.map((item,i)=>i===0?<div class="mobile-nav-group"><div class="mobile-nav-heading"><a href={item.href}><span>{item.english}</span><small>{item.label}</small></a><button class="mobile-collection-toggle" data-mobile-collection-toggle aria-label="展开三套住宿" aria-controls="mobile-stays-collection" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m4 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button></div><div id="mobile-stays-collection" class="mobile-collection" inert><div>{properties.map(p=><a class="mobile-property" href={`/stays/${p.slug}/`}><img src={p.heroImage.src} srcset={p.heroImage.srcset} sizes="72px" width="72" height="56" alt="" loading="lazy"/><span><strong>{p.chineseName}</strong><small>{p.name}</small></span><span class="mobile-property-arrow" aria-hidden="true">→</span></a>)}</div></div></div>:<a href={item.href}><span>{item.english}</span><small>{item.label}</small></a>)}</nav><div class="menu-bottom"><a class="button" href="/booking/">预订住宿</a><p>A quieter way to experience Auckland.</p></div></dialog>
