---
import ResponsiveImage from './ResponsiveImage.astro';import {landscapes} from '../data/landscapes';
interface Props{scene?:keyof typeof landscapes;title?:string;subtitle?:string;compact?:boolean;}
const {scene='sunset',title='A little closer to extraordinary.',subtitle='山海辽阔，旅途从容。',compact=false}=Astro.props;
const photo=landscapes[scene];
---
<section class:list={['landscape-break',{'landscape-compact':compact}]} data-landscape><div class="landscape-media"><ResponsiveImage photo={photo} sizes="max(100vw, 110vh)"/></div><div class="landscape-shade"></div><div class="container landscape-copy"><span class="landscape-location">{photo.caption}</span><h2 class="display" data-reveal>{title}</h2><p>{subtitle}</p></div></section>
